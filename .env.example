NODE_ENV=development
# Comma-separated origins are supported by the API.
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
PORT=4000

# Observability. Use separate Sentry projects/DSNs for web, API, and worker in production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Required in production. Use a random value of at least 32 characters.
METRICS_TOKEN=
WORKER_METRICS_PORT=9464
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_TTL_SECONDS=45
# Configure from current provider pricing. This is an estimate, not a billing record.
AI_ESTIMATED_COST_PER_VIDEO_MINUTE_USD=0

DATABASE_URL=postgresql://app_user:local_password@localhost:5432/youtube_learning?schema=public
REDIS_URL=redis://localhost:6379

GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_AGENTIC_MIN_DURATION_SECONDS=300
GEMINI_REQUEST_TIMEOUT_MS=720000
YOUTUBE_API_KEY=
# Non-secret deployment labels. Change them whenever each managed secret rotates.
GEMINI_KEY_VERSION=local-v1
YOUTUBE_KEY_VERSION=local-v1

# Development-only compatibility mode. Production validation requires this to be false.
ALLOW_ANONYMOUS_AUTH=true
# Required when anonymous authentication is disabled.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=

# Browser OIDC Authorization Code + PKCE configuration. These public values are
# normally copied from the same managed identity application as the API settings.
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/en/auth/callback

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_CREATE_TTL_MS=60000
RATE_LIMIT_CREATE_MAX=5
RATE_LIMIT_STATUS_TTL_MS=60000
RATE_LIMIT_STATUS_MAX=30
REQUEST_BODY_LIMIT_BYTES=16384

MAX_VIDEO_DURATION_SECONDS=5400
DAILY_ANALYSIS_LIMIT=5
ANALYSIS_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
RETENTION_SWEEP_INTERVAL_MS=86400000
# Use a randomly generated value of at least 32 characters in production.
AUDIT_HASH_PEPPER=development-only-audit-pepper-change-me
ANALYSIS_PROMPT_VERSION=3
ANALYSIS_SCHEMA_VERSION=3
WORKER_CONCURRENCY=2
